{
  "name": "jarvis-companions",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis remote companion for macOS, Windows, iOS and Android",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "desktop": "electron .",
    "build:desktop": "npm run build:ui && electron-builder",
    "sync": "npm run build:ui && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "it.jarvis.companion",
    "productName": "Jarvis Companion",
    "directories": {
      "output": "../dist/companions"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "ui"
      },
      {
        "from": "../dist/executor",
        "to": "executor"
      },
      {
        "from": "../dist/native-helper",
        "to": "native-helper"
      },
      {
        "from": "../assets/jarvis-icon.png",
        "to": "jarvis.png"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis registra le richieste vocali avviate da te."
      },
      "icon": "../assets/jarvis-icon.png",
      "minimumSystemVersion": "14.0"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "../assets/jarvis-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
