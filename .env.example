# Copy to .env and uncomment only settings you want to manage through env.
# Environment-provided settings take precedence and are locked in the GUI.
# Never paste keys into chat. Use private .env (chmod 600) or local settings.
# JARVIS_TIMEZONE=Europe/Rome
# JARVIS_UI_LANGUAGE=en
# JARVIS_PROFILE=local_connected

# Models: register local and cloud providers simultaneously.
# JARVIS_LOCAL_PROVIDER=ollama
# JARVIS_LOCAL_BASE_URL=http://127.0.0.1:11434
# JARVIS_LOCAL_MODEL=exact-name-from-ollama-list
# JARVIS_CLOUD_PROVIDER=openai
# JARVIS_CLOUD_MODEL=your-model-id
# JARVIS_CLOUD_API_KEY=
# JARVIS_CLOUD_REASONING_EFFORT=low
# Cloud requests require positive actual input/output rates for budget checks.
# JARVIS_MODEL_INPUT_USD_PER_MILLION=0
# JARVIS_MODEL_OUTPUT_USD_PER_MILLION=0
# JARVIS_MONTHLY_BUDGET_USD=50
# LM Studio: local_provider=openai_compatible, base_url=http://127.0.0.1:1234/v1

# Privacy and files
# JARVIS_WORKSPACE_ROOTS=["/absolute/path/project"]
# JARVIS_COMMAND_EXECUTION=approval
# JARVIS_MEMORY_CAPTURE=explicit_only  # Write policy; does not disable memory reads.
# JARVIS_RECORD_AUDIO=false

# Second Brain: canonical endpoint and a dedicated token or OAuth connection.
# JARVIS_SECOND_BRAIN_URL=http://127.0.0.1:8000/mcp
# JARVIS_SECOND_BRAIN_AUTH=bearer
# JARVIS_SECOND_BRAIN_TOKEN=
# Connected Second Brain is the default memory; authorized reads/writes need no confirmation.
# JARVIS_MEMORY_RECALL_TOKEN_BUDGET=2000

# Desktop audio: macOS app permissions and on-device wake recognition.
# This locale is independent of the conversation's response language.
# JARVIS_LANGUAGE=it-IT
# JARVIS_RESPONSE_LANGUAGE=auto
# Optional Core Audio input UID, chosen in Settings → Voice → Microphone.
# Empty follows the macOS default; a saved UID applies only to Jarvis.
# JARVIS_MICROPHONE_DEVICE_UID=
# JARVIS_WAKE_PHRASE=Jarvis
# JARVIS_FOLLOWUP_SECONDS=8
# JARVIS_TTS_VOICE=
# Natural cloud voice: local wake phrase, audio sent only after activation.
# JARVIS_DESKTOP_VOICE_PROVIDER=openai_live
# JARVIS_DESKTOP_VOICE_MODEL=gpt-live-1
# JARVIS_DESKTOP_VOICE_NAME=cedar
# Built-in name or a saved voice_… ID. Describe vocal qualities separately.
# JARVIS_DESKTOP_VOICE_STYLE="A warm, composed adult Italian male voice with fluid conversational pacing."
# echo_cancelled: local echo protection and spoken interruption (native Mac).
# gated: manual interruption; full: unprotected input for isolating headphones.
# JARVIS_DESKTOP_VOICE_DUPLEX=echo_cancelled
# JARVIS_DESKTOP_VOICE_API_KEY=
# JARVIS_DESKTOP_VOICE_MAX_SESSION_SECONDS=120
# JARVIS_DESKTOP_VOICE_IDLE_SECONDS=30
# JARVIS_DESKTOP_VOICE_RATE_USD_PER_MINUTE=0.05

# Productivity
# Lighting devices are configured in Settings; radio IDs and MCP bindings stay in private app data.
# JARVIS_LIGHTING_ENABLED=true
# JARVIS_WEATHER_LOCATION=Rome
# JARVIS_CALENDAR_PROVIDER=apple
# JARVIS_SEARCH_PROVIDER=brave
# JARVIS_SEARCH_API_KEY=

# Telephony: disabled until setup and owner authorization.
# JARVIS_TELEPHONY_ENABLED=false
# JARVIS_TELEPHONY_PUBLIC_BASE_URL=https://your-tunnel.example
# JARVIS_TELEPHONY_ACCOUNT_ID=
# JARVIS_TELEPHONY_AUTH_TOKEN=
# JARVIS_TELEPHONY_FROM_NUMBER=+...
# JARVIS_OWNER_PHONE_NUMBER=+...
# JARVIS_PHONE_PIN=
# JARVIS_PHONE_API_KEY=
# JARVIS_PHONE_STT_PROVIDER=openai
# JARVIS_PHONE_MAX_CALL_SECONDS=180
# JARVIS_PHONE_DAILY_BUDGET_USD=2
# JARVIS_QUIET_HOURS=22:00-08:00
