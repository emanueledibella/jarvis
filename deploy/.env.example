JARVIS_PUBLIC_HOST=jarvis.example.com
# A stable public IPv4 also works. Caddy uses Let's Encrypt's shortlived profile.
JARVIS_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# Provider API keys are entered in the authenticated companion, not this file.
# Optional push credentials are read only by the core. Paths are inside /run/secrets.
JARVIS_APNS_TEAM_ID=
JARVIS_APNS_KEY_ID=
JARVIS_APNS_PRIVATE_KEY=
JARVIS_APNS_TOPIC=it.jarvis.companion
JARVIS_APNS_SANDBOX=false
JARVIS_FCM_SERVICE_ACCOUNT=
# Optional sandbox broker: numeric Docker socket group on its Linux host.
# Read with: stat -c %g /var/run/docker.sock
JARVIS_DOCKER_GID=0
